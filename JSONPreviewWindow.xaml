<Window x:Class="EtherCAT_Studio.JSONPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JSON 프리뷰 및 저장" Height="600" Width="800"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterOwner">
    
    <DockPanel>
        <!-- Title Bar -->
        <TextBlock DockPanel.Dock="Top" Text="생성된 JSON 시퀀스" 
                   FontSize="14" FontWeight="Bold" 
                   Foreground="White" Margin="12,12,12,6" />
        
        <!-- JSON Display -->
        <TextBox DockPanel.Dock="Top" 
                 Name="JsonDisplay"
                 Background="#2D2D2D" 
                 Foreground="#00FF00"
                 FontFamily="Consolas" 
                 FontSize="11"
                 Margin="12,6,12,12"
                 Height="400"
                 Padding="8"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 IsReadOnly="True" />
        
        <!-- Button Panel -->
        <StackPanel DockPanel.Dock="Bottom" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="12,12,12,12"
                    Height="40">
            
            <Button Name="ConvertBtn" 
                    Content="Node 변환" 
                    Width="120" 
                    Margin="4"
                    Background="#0078D4" 
                    Foreground="White"
                    FontSize="12"
                    Click="ConvertBtn_Click" />
            
            <Button Name="SaveBtn" 
                    Content="파일 저장" 
                    Width="120" 
                    Margin="4"
                    Background="#107C10" 
                    Foreground="White"
                    FontSize="12"
                    Click="SaveBtn_Click" />
            
            <Button Name="CancelBtn" 
                    Content="취소" 
                    Width="120" 
                    Margin="4"
                    Background="#6C757D" 
                    Foreground="White"
                    FontSize="12"
                    Click="CancelBtn_Click" />
        </StackPanel>
    </DockPanel>
</Window>
