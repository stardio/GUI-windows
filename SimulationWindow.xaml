<Window x:Class="EtherCAT_Studio.SimulationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="3D Simulation" Height="720" Width="1100"
    Background="Transparent" WindowStartupLocation="CenterOwner"
    WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#90232323" Padding="8" Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PlayButton" Content="Play" Width="80" Height="32" Margin="0,0,8,0" Click="Play_Click"/>
                <Button x:Name="PauseButton" Content="Pause" Width="80" Height="32" Margin="0,0,8,0" Click="Pause_Click"/>
                <Button x:Name="StopButton" Content="Stop" Width="80" Height="32" Margin="0,0,8,0" Click="Stop_Click"/>
                <Button x:Name="ResetButton" Content="Reset" Width="80" Height="32" Margin="0,0,16,0" Click="Reset_Click"/>
                <TextBlock Text="Speed" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="SpeedSlider" Width="180" Minimum="0.2" Maximum="5" Value="1" SmallChange="0.1" LargeChange="0.5"/>
                <TextBlock x:Name="SpeedText" Text="1.0x" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="View Scale" Foreground="White" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <Slider x:Name="ViewScaleSlider" Width="160" Minimum="0.5" Maximum="2.0" Value="1" SmallChange="0.05" LargeChange="0.1"/>
                <TextBlock x:Name="ViewScaleText" Text="1.00" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Background="Transparent">
                <Viewport3D x:Name="Viewport" ClipToBounds="True"
                            MouseWheel="Viewport_MouseWheel"
                            MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                            MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                            MouseMove="Viewport_MouseMove">
                    <Viewport3D.LayoutTransform>
                        <ScaleTransform x:Name="ViewportScale" ScaleX="1" ScaleY="1" />
                    </Viewport3D.LayoutTransform>
                    <Viewport3D.Camera>
                        <PerspectiveCamera x:Name="MainCamera" Position="500,-800,600" LookDirection="-500,800,-600" UpDirection="0,0,1" FieldOfView="45" />
                    </Viewport3D.Camera>
                </Viewport3D>
            </Border>

            <Border Grid.Column="0" Background="Transparent" Padding="10">
                <StackPanel>
                    <TextBlock Text="Current Step" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                    <TextBlock x:Name="CurrentStepText" Text="-" Foreground="#9BE7FF" FontSize="13" Margin="0,0,0,8" />
                    <TextBlock Text="JSON" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                    <TextBox x:Name="StepJsonText" Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="White" FontFamily="Consolas" FontSize="14" />

                    <TextBlock Text="Edit Variables (values only)" Foreground="#C8C8C8" FontSize="11" Margin="0,8,0,4" />
                    <DataGrid x:Name="ParamGrid" Height="150" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Background="Transparent" Foreground="White"
                              GridLinesVisibility="None" BorderBrush="#3A3A3A" BorderThickness="1"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent">
                        <DataGrid.Resources>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#3A3A3A" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#3A3A3A" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#3A3A3A" />
                            </Style>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#3A3A3A" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#3A3A3A" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Apply" Width="80" Margin="0,0,8,0" Click="ApplyJson_Click" />
                        <Button Content="Save" Width="80" Margin="0,0,8,0" Click="SaveJson_Click" />
                        <Button Content="Save As" Width="90" Click="SaveAsJson_Click" />
                    </StackPanel>
                    <TextBlock Text="Steps" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,12,0,6" />
                    <ListBox x:Name="StepList" Height="190" Background="Transparent" BorderThickness="0"
                             Foreground="White" FontFamily="Consolas" FontSize="14"
                             SelectionChanged="StepList_SelectionChanged" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10"
                    Background="#66232323" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#FF5050" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Text="X:" TextAlignment="Left" />
                    <TextBlock x:Name="CoordValueX" Grid.Row="0" Grid.Column="1" Foreground="#FF5050" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Text="0" TextAlignment="Right" Width="90" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#50FF80" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Text="Y:" TextAlignment="Left" />
                    <TextBlock x:Name="CoordValueY" Grid.Row="1" Grid.Column="1" Foreground="#50FF80" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Text="0" TextAlignment="Right" Width="90" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Foreground="#50A0FF" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Text="Z:" TextAlignment="Left" />
                    <TextBlock x:Name="CoordValueZ" Grid.Row="2" Grid.Column="1" Foreground="#50A0FF" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Text="0" TextAlignment="Right" Width="90" />
                </Grid>
            </Border>

            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,120,12,0" Padding="10"
                    Background="Transparent" CornerRadius="8">
                <Border.Resources>
                    <Style x:Key="CamButtonStyle" TargetType="Button">
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="MinWidth" Value="72" />
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="Background" Value="#3A3A3A" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="#555" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <TextBlock Text="Camera" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                    <UniformGrid Columns="2" Rows="4">
                        <Button Content="Front" Style="{StaticResource CamButtonStyle}" Click="CamFront_Click" />
                        <Button Content="Back" Style="{StaticResource CamButtonStyle}" Click="CamBack_Click" />
                        <Button Content="Left" Style="{StaticResource CamButtonStyle}" Click="CamLeft_Click" />
                        <Button Content="Right" Style="{StaticResource CamButtonStyle}" Click="CamRight_Click" />
                        <Button Content="Top" Style="{StaticResource CamButtonStyle}" Click="CamTop_Click" />
                        <Button Content="Bottom" Style="{StaticResource CamButtonStyle}" Click="CamBottom_Click" />
                        <Button Content="ISO" Style="{StaticResource CamButtonStyle}" Click="CamIso_Click" />
                        <Button Content="Fit" Style="{StaticResource CamButtonStyle}" Click="CamFit_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
